meta {
  name: CrearDB
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/admin/tenants
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-ADMIN-TOKEN: {{adminToken}}
}

body:json {
  {
    "name": "gothen",
    "domain": "gothen.app.test",
    "database": "gothen"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
