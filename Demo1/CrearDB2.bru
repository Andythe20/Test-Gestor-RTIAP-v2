meta {
  name: CrearDB2
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/admin/tenants
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-ADMIN-TOKEN: {{adminToken}}
}

body:json {
  {
    "name": "acme",
    "domain": "acme.app.test",
    "database": "tenant_acme"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
